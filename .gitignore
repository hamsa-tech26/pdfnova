# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/ocr-runtime/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Release 36 OCR reports: keep private measurements out of source control
/benchmarks/phase10_14/reports/*.json
/benchmarks/phase10_14/reports/raw/

# CI-only public HTTP and local mobile diagnostic metadata
/benchmarks/website/reports/

# Release 51: generated PDFs and locally held private golden data
/test-fixtures/golden/
/benchmarks/golden/reports/
/benchmarks/golden/private/

# Engine V4 real-world qualification: never commit source PDFs, annotations or raw outputs
/benchmarks/release37/private/
/benchmarks/release37/reports/
/test-fixtures/release37/

# R112: original publisher PDFs, PubTables XML and per-run numeric CI reports
/benchmarks/release112/private/
/benchmarks/release112/reports/

# Ephemeral corrected ICDAR PDFs + annotations, never commit user/reference bytes
benchmarks/icdar/private/
